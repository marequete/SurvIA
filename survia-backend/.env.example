# ─── SurvIA License Backend (Fly.io + Neon) ─────────────────────────────
# Copier ce fichier en .env et remplir les valeurs avant déploiement

# PostgreSQL Neon (free tier permanent) : https://neon.tech → New Project → copier DATABASE_URL
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/survia_licenses?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Clés Ed25519 (générer avec: npm run generate-keys)
ED25519_PRIVATE_KEY_HEX=
ED25519_PUBLIC_KEY_HEX=

# Port d'écoute (Leapcell utilise 8080 par défaut)
PORT=8080
